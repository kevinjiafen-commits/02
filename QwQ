local KILL_SEAT_REFINE_LATTICE = (function()
    local lattice = {}
    for x = -1, 1 do
        for y = -1, 1 do
            for z = -1, 1 do
                if not (x == 0 and y == 0 and z == 0) then
                    lattice[#lattice + 1] = Vector3.new(x, y, z)
                end
            end
        end
    end
    return lattice
end)()

local function IsPointInOOBVolume(pos)
    for _, safe in ipairs(CollectionService:GetTagged('OutOfBoundsSafePart')) do
        if safe:IsA('BasePart') then
            local rel = safe.CFrame:PointToObjectSpace(pos)
            local hx, hy, hz = safe.Size.X * 0.5, safe.Size.Y * 0.5, safe.Size.Z * 0.5
            if math.abs(rel.X) <= hx and math.abs(rel.Y) <= hy and math.abs(rel.Z) <= hz then
                return false
            end
        end
    end
    for _, oob in ipairs(CollectionService:GetTagged('OutOfBoundsPart')) do
        if oob:IsA('BasePart') then
            local rel = oob.CFrame:PointToObjectSpace(pos)
            local hx, hy, hz = oob.Size.X * 0.5, oob.Size.Y * 0.5, oob.Size.Z * 0.5
            if math.abs(rel.X) <= hx and math.abs(rel.Y) <= hy and math.abs(rel.Z) <= hz then
                return true
            end
        end
    end
    return false
end

local function GetOOBPartAt(pos)
    for _, safe in ipairs(CollectionService:GetTagged('OutOfBoundsSafePart')) do
        if safe:IsA('BasePart') then
            local rel = safe.CFrame:PointToObjectSpace(pos)
            local hx, hy, hz = safe.Size.X * 0.5, safe.Size.Y * 0.5, safe.Size.Z * 0.5
            if math.abs(rel.X) <= hx and math.abs(rel.Y) <= hy and math.abs(rel.Z) <= hz then
                return nil
            end
        end
    end
    for _, oob in ipairs(CollectionService:GetTagged('OutOfBoundsPart')) do
        if oob:IsA('BasePart') then
            local rel = oob.CFrame:PointToObjectSpace(pos)
            local hx, hy, hz = oob.Size.X * 0.5, oob.Size.Y * 0.5, oob.Size.Z * 0.5
            if math.abs(rel.X) <= hx and math.abs(rel.Y) <= hy and math.abs(rel.Z) <= hz then
                return oob
            end
        end
    end
    return nil
end

function RagebotScoreSeatPosition(pos)
    if IsPointInOOBVolume(pos) then return -1 end
    local distinctParts = {}
    local distinctCount = 0
    local hitCount = 0
    local cardinalHits = 0
    local rayLen = 8
    for _, dir in ipairs(KILL_SEAT_SAMPLE_DIRECTIONS) do
        local samplePos = pos + dir * rayLen
        local hitPart = GetOOBPartAt(samplePos)
        if hitPart then
            hitCount = hitCount + 1
            if not distinctParts[hitPart] then
                distinctParts[hitPart] = true
                distinctCount = distinctCount + 1
            end
            if (math.abs(dir.X) + math.abs(dir.Y) + math.abs(dir.Z)) < 1.05 then
                cardinalHits = cardinalHits + 1
            end
        end
    end
    if hitCount == 0 then return 0 end
    return cardinalHits * 10000 + distinctCount * 1000 + hitCount
end

function RagebotRefineKillSeatPosition(seatPos)
    local step = 0.05
    local bestPos = seatPos
    local bestScore = RagebotScoreSeatPosition(seatPos)
    for _, offset in ipairs(KILL_SEAT_REFINE_LATTICE) do
        local candidatePos = seatPos + offset * step
        local s = RagebotScoreSeatPosition(candidatePos)
        if s > bestScore then
            bestScore = s
            bestPos = candidatePos
        end
    end
    return bestPos
end

function RagebotBuildKillSeats(force)
    local now = tick()
    if not force and state.KillSeats and (now - state.KillSeatsBuiltAt) < 60 then
        return state.KillSeats
    end
    local oobParts = CollectionService:GetTagged('OutOfBoundsPart')
    if not oobParts or #oobParts == 0 then
        state.KillSeats = {}
        state.KillSeatsBuiltAt = now
        return state.KillSeats
    end
    local buffer = 4
    local rayLen = 8
    local candidates = {}
    for _, oob in ipairs(oobParts) do
        if oob:IsA('BasePart') then
            local size = oob.Size
            local cframe = oob.CFrame
            local hx, hy, hz = size.X * 0.5, size.Y * 0.5, size.Z * 0.5
            for _, axis in ipairs(KILL_SEAT_AXIS_OFFSETS) do
                local localOffset = Vector3.new(
                    axis.X * (hx + buffer),
                    axis.Y * (hy + buffer),
                    axis.Z * (hz + buffer)
                )
                local seatPos = cframe:PointToWorldSpace(localOffset)
                if not IsPointInOOBVolume(seatPos) then
                    local distinctParts = {}
                    local distinctCount = 0
                    local hitCount = 0
                    local cardinalHits = 0
                    for _, dir in ipairs(KILL_SEAT_SAMPLE_DIRECTIONS) do
                        local samplePos = seatPos + dir * rayLen
                        local hitPart = GetOOBPartAt(samplePos)
                        if hitPart then
                            hitCount = hitCount + 1
                            if not distinctParts[hitPart] then
                                distinctParts[hitPart] = true
                                distinctCount = distinctCount + 1
                            end
                            if (math.abs(dir.X) + math.abs(dir.Y) + math.abs(dir.Z)) < 1.05 then
                                cardinalHits = cardinalHits + 1
                            end
                        end
                    end
                    if hitCount > 0 then
                        table.insert(candidates, {
                            Position = seatPos,
                            Score = cardinalHits * 10000 + distinctCount * 1000 + hitCount,
                        })
                    end
                end
            end
        end
    end
    table.sort(candidates, function(a, b) return a.Score > b.Score end)
    state.KillSeats = candidates
    state.KillSeatsBuiltAt = now
    return candidates
end

function RagebotPickKillSeatNearestTarget(referencePos)
    local now = tick()
    if state.CurrentKillSeat and (now - state.LastKillSeatPickAt) < 0.4 then
        return state.CurrentKillSeat
    end
    local seats = RagebotBuildKillSeats(false)
    if not seats or #seats == 0 then
        state.CurrentKillSeat = nil
        state.LastKillSeatPickAt = now
        return nil
    end
    local bestSeat = nil
    local bestComposite = math.huge
    for _, seat in ipairs(seats) do
        local dist = referencePos and (seat.Position - referencePos).Magnitude or 0
        local composite = -seat.Score + dist * 0.05
        if composite < bestComposite then
            bestComposite = composite
            bestSeat = seat
        end
    end
    local picked = nil
    if bestSeat then
        if not bestSeat.RefinedPosition then
            bestSeat.RefinedPosition = RagebotRefineKillSeatPosition(bestSeat.Position)
        end
        picked = bestSeat.RefinedPosition
    end
    state.CurrentKillSeat = picked
    state.LastKillSeatPickAt = now
    return picked
end

function RagebotUpdateHostileTeleportTracker(now)
    local minDt = 0.05
    if (now - (state.LastHostileTrackerSampleAt or 0)) < minDt then return end
    state.LastHostileTrackerSampleAt = now
    local hostileTeleports = state.HostileTeleports
    local fc = ResolveFighterController()
    local fighters = fc and fc.Objects or {}
    for _, fighter in ipairs(fighters) do
        local player = fighter and fighter.Player
        if player and player ~= LP and player.Parent == Players then
            local char = player.Character
            local hrp = char and char:FindFirstChild('HumanoidRootPart')
            if hrp and hrp.Parent then
                local entry = hostileTeleports[player]
                if not entry then
                    entry = { LastPos = hrp.Position, LastCheckedAt = now, Teleports = {}, Offsets = {} }
                end
                hostileTeleports[player] = entry
                entry.SeenAt = now
                local dt = now - entry.LastCheckedAt
                if dt >= minDt then
                    local dist = (hrp.Position - entry.LastPos).Magnitude
                    if dist > 50 and (dist / dt) > 150 then
                        table.insert(entry.Teleports, now)
                        local localChar = LP and LP.Character
                        local localHrp = localChar and localChar:FindFirstChild('HumanoidRootPart')
                        if localHrp then
                            table.insert(entry.Offsets, { Time = now, Offset = hrp.Position - localHrp.Position })
                        end
                    end
                    entry.LastPos = hrp.Position
                    entry.LastCheckedAt = now
                end
                local windowSec = 5
                for index = #entry.Teleports, 1, -1 do
                    if (now - entry.Teleports[index]) >= windowSec then
                        table.remove(entry.Teleports, index)
                    end
                end
                for index = #entry.Offsets, 1, -1 do
                    if (now - entry.Offsets[index].Time) >= windowSec then
                        table.remove(entry.Offsets, index)
                    end
                end
            end
        end
    end
    for player, entry in pairs(hostileTeleports) do
        if entry.SeenAt ~= now then
            hostileTeleports[player] = nil
        end
    end
end

function RagebotIsHostileCheating()
    local minCount = 1
    local hostileTeleports = state.HostileTeleports
    if not hostileTeleports then return false end
    for _, entry in pairs(hostileTeleports) do
        if entry.Teleports and #entry.Teleports >= minCount then
            return true
        end
    end
    return false
end

function RagebotGetMostActiveCheater()
    local hostileTeleports = state.HostileTeleports
    if not hostileTeleports then return nil end
    local bestPlayer, bestCount = nil, 0
    for player, entry in pairs(hostileTeleports) do
        local count = entry.Teleports and #entry.Teleports or 0
        if count > bestCount then
            bestCount = count
            bestPlayer = player
        end
    end
    return bestPlayer, bestCount
end

function RagebotGetCheaterOffsetPrediction(player)
    local entry = player and state.HostileTeleports and state.HostileTeleports[player]
    if not entry or not entry.Offsets then return nil end
    local samples = 5
    local minSamples = 1
    local total = #entry.Offsets
    if total < minSamples then return nil end
    local startIdx = math.max(1, total - samples + 1)
    local sum = Vector3.zero
    local count = 0
    for i = startIdx, total do
        sum = sum + entry.Offsets[i].Offset
        count = count + 1
    end
    if count == 0 then return nil end
    return sum / count
end

function RagebotFindBaitTrapPosition(predictedOffset)
    if not predictedOffset then return nil end
    local seats = RagebotBuildKillSeats(false)
    if not seats or #seats == 0 then return nil end
    local localChar = LP and LP.Character
    local localHrp = localChar and localChar:FindFirstChild('HumanoidRootPart')
    local refPos = localHrp and localHrp.Position or nil
    local maxDist = 60
    local bestSeat, bestComposite = nil, math.huge
    for _, seat in ipairs(seats) do
        if seat.Position then
            local landingPos = seat.Position + predictedOffset
            if IsPointInOOBVolume(landingPos) then
                local dist = refPos and (seat.Position - refPos).Magnitude or 0
                if not refPos or dist <= maxDist then
                    local composite = dist - (seat.Score * 0.0001)
                    if composite < bestComposite then
                        bestComposite = composite
                        bestSeat = seat
                    end
                end
            end
        end
    end
    if not bestSeat then return nil end
    if not bestSeat.RefinedPosition then
        bestSeat.RefinedPosition = RagebotRefineKillSeatPosition(bestSeat.Position)
    end
    return bestSeat.RefinedPosition or bestSeat.Position
end

function RagebotPivotToBaitTrapOrSnug()
    local now = tick()
    if state.LastBaitTrapPos and (now - (state.LastBaitTrapPickAt or 0)) < 0.6 then
        local activeChar = LP.Character
        if activeChar then
            local cur = activeChar:GetPivot()
            activeChar:PivotTo(CFrame.new(state.LastBaitTrapPos) * (cur - cur.Position))
            return true
        end
    end
    local cheater = RagebotGetMostActiveCheater()
    local predicted = cheater and RagebotGetCheaterOffsetPrediction(cheater) or nil
    local trapPos = predicted and RagebotFindBaitTrapPosition(predicted) or nil
    if not trapPos then
        local seats = RagebotBuildKillSeats(false)
        if seats and #seats > 0 then
            local snug = seats[1]
            if not snug.RefinedPosition then
                snug.RefinedPosition = RagebotRefineKillSeatPosition(snug.Position)
            end
            trapPos = snug.RefinedPosition or snug.Position
        end
    end
    if not trapPos then return false end
    state.LastBaitTrapPos = trapPos
    state.LastBaitTrapPickAt = now
    local activeChar = LP.Character
    if not activeChar then return false end
    local cur = activeChar:GetPivot()
    activeChar:PivotTo(CFrame.new(trapPos) * (cur - cur.Position))
    return true
end

local function ResolveRespawnRemote()
    local remote = findChild(ReplicatedStorage, 'Remotes', 'Duels', 'RespawnNow')
    if remote and remote:IsA('RemoteEvent') then return remote end
    return nil
end

function RagebotTryRespawn()
    if not togValue('P8S4T2', false) then return false end
    local now = tick()
    if (now - state.LastRespawnRequestAt) < 1 then return false end
    local respawnNow = ResolveRespawnRemote()
    if not respawnNow then return false end
    state.LastRespawnRequestAt = now
    task.spawn(function()
        for i = 1, 5 do
            local fire = clonefunction(respawnNow.FireServer)
            pcall(fire, respawnNow)
            if i < 5 then task.wait(0.1) end
        end
    end)
    return true
end

function RagebotRegisterRespawnSignals()
    local binding = state.RespawnBinding
    if not binding then
        local hook = requireModuleRB('ReplicateHook')
        if hook and hook.Reserve then
            binding = hook:Reserve({ 'RespawnNowAnimation' })
            if binding then
                binding:SetHandler(function(packet)
                    if packet.enumName == 'RespawnNowAnimation' and packet.args[1] == LP then
                        RagebotTryRespawn()
                    end
                end)
                state.RespawnBinding = binding
            end
        end
    end
    if binding then
