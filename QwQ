local GAME_ID = game.GameId
local IS_RIVALS = (GAME_ID == 6035872082)

controllerInstance = nil

local function InitializeRagebot()
    if not IS_RIVALS then
        Library:Notify("Ragebot 仅支持 RIVALS 游戏 (ID: 6035872082)", "warning")
        return false
    end

    local char = LP.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        Library:Notify("等待角色加载...", "info")
        repeat
            task.wait(0.5)
            char = LP.Character
        until char and char:FindFirstChild("HumanoidRootPart")
    end

    controllerInstance = Controller.new()
    
    if _G.RagebotSettings.P8S4T1 then
        controllerInstance:SetEnabled(true)
        Library:Notify("Ragebot 已启动", "success")
    end
    
    if _G.RagebotSettings.P8S4T2 then
        RagebotRegisterRespawnSignals()
    end
    
    return true
end

local function RagebotLoop()
    if not IS_RIVALS then return end
    
    local char = LP.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        return
    end
    
    if not controllerInstance then
        controllerInstance = Controller.new()
        if _G.RagebotSettings.P8S4T1 then
            controllerInstance:SetEnabled(true)
        end
    end
    
    local dt = RunService.Heartbeat:Wait()
    KiciaRagebot.Update(dt)
end

local function StartRagebotWithRetry()
    if not IS_RIVALS then
        Library:Notify("当前游戏不是 RIVALS，Ragebot 已禁用", "warning")
        return
    end
    
    local success = InitializeRagebot()
    if not success then
        task.delay(10, StartRagebotWithRetry)
        return
    end
    
    task.spawn(RagebotLoop)
end

game:GetService("TeleportService"):GetPropertyChangedSignal("TeleportState"):Connect(function()
    if game:GetService("TeleportService").TeleportState == Enum.TeleportState.Teleporting then
        Library:Notify("正在传送... Ragebot 将在新服务器重新初始化", "info")
        if controllerInstance then
            controllerInstance:Destroy()
            controllerInstance = nil
        end
        task.delay(5, function()
            StartRagebotWithRetry()
        end)
    end
end)

