local function findChild(root, ...)
    local node = root
    for _, name in ipairs({ ... }) do
        if not node then return nil end
        node = node:FindFirstChild(name)
    end
    return node
end

local EnumLibrary
local function ResolveEnumLibrary()
    if EnumLibrary then return EnumLibrary end
    local mod = findChild(ReplicatedStorage, 'Modules', 'EnumLibrary')
    if mod then
        local ok, lib = pcall(require, mod)
        if ok and type(lib) == 'table' then
            if lib.WaitForEnumBuilder then lib:WaitForEnumBuilder() end
            EnumLibrary = lib
            return lib
        end
    end
    return nil
end

local function enc(name)
    local lib = ResolveEnumLibrary()
    if lib and lib.ToEnum then
        local ok, token = pcall(lib.ToEnum, lib, name)
        if ok then return token end
    end
    return nil
end

local function optValue(id, default)
    local s = _G.RagebotSettings or {}
    local v = s[id]
    if v ~= nil then return v end
    return default
end
local function togValue(id, default)
    local s = _G.RagebotSettings or {}
    local v = s[id]
    if v ~= nil then return v == true end
    return default
end

